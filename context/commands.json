{
  "destructive": [
    "rm",
    "rmdir",
    "dd",
    "sudo",
    "chmod",
    "chown",
    "mkfs",
    "truncate",
    "shred",
    "git push",
    "git reset",
    "git clean",
    "git rebase",
    "git commit",
    "pip install",
    "pip uninstall",
    "npm install",
    "npm uninstall",
    "uv add",
    "uv remove",
    "yarn add",
    "yarn remove",
    "pnpm add",
    "pnpm remove",
    "brew install",
    "brew uninstall",
    "> "
  ],
  "safe": [
    "ls",
    "cat",
    "echo",
    "pwd",
    "whoami",
    "which",
    "find",
    "grep",
    "head",
    "tail",
    "wc",
    "pytest",
    "git status",
    "git log",
    "git diff",
    "git show",
    "git branch",
    "git fetch",
    "uv run",
    "uv sync",
    "uv lock",
    "uv show",
    "uv tree"
  ],
  "ignored_paths": [
    ".git/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/*.pyc",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.crt",
    "**/*.cer",
    "**/id_rsa",
    "**/id_ed25519",
    "**/*.secret",
    "**/secrets.json",
    "**/credentials.json"
  ]
}
